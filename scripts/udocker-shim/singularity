#!/usr/bin/env python3
"""A `singularity` command that is really udocker underneath.

Harbor ships an HPC environment backend that shells out to `singularity`, and
DTU's cluster provides no container runtime at all: Docker needs a root daemon,
Apptainer needs either a setuid binary or unprivileged user namespaces, and
`/proc/sys/user/max_user_namespaces` is 0 on both the login and the compute
nodes. udocker runs the same Docker images entirely in user space via PRoot, so
it works where those do not.

Rather than fork Harbor's backend, this translates the only two command forms it
issues. Both were read off `harbor/environments/singularity/singularity.py`,
which constructs `singularity` argv in exactly two places:

    singularity pull <out.sif> docker://<image>
    singularity exec [flags] <image.sif> <command...>

Everything else in that backend, including the in-container server and the HTTP
protocol it speaks, is runtime-agnostic and is used unchanged.

Put this directory first on PATH and set UDOCKER, or leave UDOCKER unset and
have `udocker` itself on PATH.
"""

import os
import shlex
import shutil
import signal
import subprocess
import sys
import time
import uuid
from pathlib import Path

UDOCKER = os.environ.get("UDOCKER", "udocker")

# Seconds between asking the container tree to stop and killing it outright.
GRACE = float(os.environ.get("AFB_SHIM_GRACE", 20))

# Where to record the process groups this shim starts, so that the surrounding
# batch job can tear down anything that outlives the shim itself. Unset outside
# a job, where there is nothing to clean up after.
PIDFILE = os.environ.get("AFB_SHIM_PIDFILE", "")

# Where to record the containers this shim creates. Removal normally happens
# here, but a shim that is SIGKILLed cannot remove anything, and each abandoned
# rootfs is around three gigabytes.
REGISTRY = os.environ.get("AFB_SHIM_CONTAINERS", "")

# udocker has no .sif format. The backend only ever treats the path as an opaque
# handle that it writes once and passes back to `exec`, so a text file holding
# the image reference satisfies every use it makes of one.
MARKER = "# udocker-shim image reference\n"


def fail(message: str) -> int:
    print(f"singularity-udocker-shim: {message}", file=sys.stderr)
    return 1


def have_locally(image: str) -> bool:
    """Whether `udocker images` already lists this reference."""
    listing = subprocess.run(
        [UDOCKER, "images"], capture_output=True, text=True, check=False
    )
    if listing.returncode != 0:
        return False
    wanted = image if ":" in image else f"{image}:latest"
    return any(line.split()[0] == wanted for line in listing.stdout.splitlines() if line.split())


def pull(argv: list[str]) -> int:
    """singularity pull <out.sif> docker://<image>"""
    positional = [a for a in argv if not a.startswith("-")]
    if len(positional) != 2:
        return fail(f"expected 'pull <out.sif> docker://<image>', got {argv}")

    out, source = positional
    image = source.removeprefix("docker://")

    # An image built locally with `udocker import`, which is how a warmed image
    # is made, exists only in the local repository. Pulling it asks a registry
    # for a manifest that was never published, so check locally first.
    if not have_locally(image):
        result = subprocess.run([UDOCKER, "pull", image])
        if result.returncode != 0:
            return fail(f"udocker pull {image} failed")

    Path(out).write_text(f"{MARKER}{image}\n", encoding="utf-8")
    return 0


def resolve_image(path: str) -> str:
    """Read back what `pull` wrote, or accept a bare image reference."""
    candidate = Path(path)
    if candidate.is_file():
        text = candidate.read_text(encoding="utf-8")
        if text.startswith(MARKER):
            return text[len(MARKER) :].strip()
    # A task may name an image directly rather than going through pull.
    return path


def exec_(argv: list[str]) -> int:
    """singularity exec [flags] <image.sif> <command...>

    Flag translation, with the ones that have no user-space equivalent dropped
    rather than faked:

      --pwd D          -> mkdir -p D && cd D, inside the container
      -B src:tgt       -> --volume=src:tgt
      --fakeroot       -> --user=root
      --no-mount X     dropped, udocker mounts nothing implicitly
      --writable-tmpfs dropped, a udocker container's rootfs is already writable
      --containall     dropped, udocker does not import the host environment
      --pid            dropped, PRoot provides no PID namespace
    """
    options: list[str] = []
    workdir: str | None = None
    index = 0

    while index < len(argv):
        argument = argv[index]
        if argument in ("-B", "--bind"):
            index += 1
            if index >= len(argv):
                return fail("-B given without a mount specification")
            options.append(f"--volume={argv[index]}")
        elif argument == "--pwd":
            index += 1
            if index >= len(argv):
                return fail("--pwd given without a directory")
            workdir = argv[index]
        elif argument == "--fakeroot":
            options.append("--user=root")
        elif argument == "--no-mount":
            index += 1  # and drop its value
        elif argument in ("--writable-tmpfs", "--containall", "--pid", "--writable"):
            pass
        elif argument.startswith("-"):
            print(
                f"singularity-udocker-shim: ignoring unhandled flag {argument}",
                file=sys.stderr,
            )
        else:
            break
        index += 1

    if index >= len(argv):
        return fail("no image given")

    image = resolve_image(argv[index])
    command = argv[index + 1 :]

    # udocker rejects --workdir for a directory that does not exist in the
    # image, where Singularity created it implicitly under --writable-tmpfs.
    # Harbor's working directory usually does not exist (task images are not
    # required to ship /app), so make it inside the container instead. The
    # placeholder argument after -c becomes $0, leaving the original argv as
    # "$@" untouched, which matters because that argv contains its own quoting.
    if workdir is not None:
        command = [
            "/bin/sh",
            "-c",
            f"mkdir -p {shlex.quote(workdir)} && cd {shlex.quote(workdir)} && exec \"$@\"",
            "sh",
            *command,
        ]

    # udocker's own --rm cannot be relied on. PRoot leaves directories inside the
    # rootfs that the invoking user cannot read, udocker's removal fails on them,
    # and it reports nothing. A run of 89 Terminal-Bench trials left 63 abandoned
    # rootfs copies of roughly a gigabyte each and exhausted the disk quota at
    # trial 67, so the container is created under a known name here and removed
    # explicitly, with the permissions repaired first.
    name = f"afb-{uuid.uuid4().hex[:12]}"
    created = subprocess.run(
        [UDOCKER, "create", f"--name={name}", image],
        capture_output=True,
        text=True,
        check=False,
    )
    if created.returncode != 0:
        return fail(f"udocker create from {image} failed: {created.stderr.strip()}")
    record_container(name, created.stdout.strip())

    full = [UDOCKER, "run", *options, name, *command]
    print(
        "singularity-udocker-shim: " + " ".join(shlex.quote(part) for part in full),
        file=sys.stderr,
    )
    try:
        return supervise(full)
    finally:
        detach_removal(name, created.stdout.strip())


class Terminated(BaseException):
    """A signal arrived, raised so the cleanup in `finally` still runs."""

    def __init__(self, signum: int) -> None:
        super().__init__(signum)
        self.signum = signum


def supervise(full: list[str]) -> int:
    """Run the container and guarantee nothing of it survives this process.

    Harbor stops a trial by sending SIGTERM to what it believes is Singularity,
    which is this shim. Python's default SIGTERM handler ends the process at
    once: no `finally` runs, and nothing signals the udocker and PRoot processes
    underneath, which are left orphaned. On 2026-08-22 a trial killed that way
    kept running on the compute node after its job had finished, holding a GPU
    it was not using until cluster support noticed.

    So the child gets its own process group, every stop signal is turned into an
    exception, and the whole group is torn down on the way out.
    """
    child = subprocess.Popen(full, start_new_session=True)
    record_group(child)
    signalled = False

    def raise_terminated(signum, frame):
        raise Terminated(signum)

    installed = {}
    for received in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        installed[received] = signal.signal(received, raise_terminated)
    try:
        return child.wait()
    except Terminated as stop:
        print(
            f"singularity-udocker-shim: signal {stop.signum}, stopping the container",
            file=sys.stderr,
        )
        signalled = True
        return 128 + stop.signum
    finally:
        for received, previous in installed.items():
            signal.signal(received, previous)
        reap(child, hard=signalled)


def record_group(child: subprocess.Popen) -> None:
    """Note the child's process group for the batch job's own cleanup.

    Belt and braces: the supervision below handles a signalled shim, but a shim
    that is SIGKILLed cannot clean up after itself, and an abandoned container
    holds a compute node until somebody notices.
    """
    if not PIDFILE:
        return
    try:
        with open(PIDFILE, "a", encoding="utf-8") as handle:
            handle.write(f"{os.getpgid(child.pid)}\n")
    except OSError as error:
        print(f"singularity-udocker-shim: could not record pgid: {error}", file=sys.stderr)


def record_container(name: str, container_id: str) -> None:
    """Note a created container so the batch job can remove what this shim cannot."""
    if not REGISTRY:
        return
    try:
        with open(REGISTRY, "a", encoding="utf-8") as handle:
            handle.write(f"{container_id}\t{name}\n")
    except OSError as error:
        print(f"singularity-udocker-shim: could not record container: {error}", file=sys.stderr)


def detach_removal(name: str, container_id: str) -> None:
    """Remove the container in a process that outlives this one.

    Deleting a rootfs on the cluster's parallel filesystem is metadata-bound and
    takes minutes, while Harbor force-kills what it takes to be Singularity on a
    much shorter timer. Removing inline therefore loses the race whenever the
    trial was stopped rather than finished. A detached child is in its own
    session, so the kill aimed at this shim does not reach it.
    """
    try:
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "remove", container_id, name],
            start_new_session=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError as error:
        print(f"singularity-udocker-shim: {error}, removing inline", file=sys.stderr)
        remove_container(name, container_id)


def sweep() -> int:
    """Remove every container named in the registry. Used by the batch job's cleanup."""
    if not REGISTRY or not Path(REGISTRY).is_file():
        return 0
    removed = 0
    for line in Path(REGISTRY).read_text(encoding="utf-8").splitlines():
        container_id, _, name = line.partition("\t")
        if not name:
            continue
        removed += remove_container(name, container_id)
    print(f"singularity-udocker-shim: swept {removed} container(s)", file=sys.stderr)
    Path(REGISTRY).unlink(missing_ok=True)
    return 0


def reap(child: subprocess.Popen, hard: bool = False) -> None:
    """Terminate the child's whole process group, then make sure of it.

    The group matters more than the child: udocker is a Python wrapper that
    execs PRoot, which in turn holds the container's own processes, and killing
    only the wrapper leaves the rest behind.

    `hard` skips the polite SIGTERM. It is set when this shim has itself been
    signalled, because Harbor follows its own SIGTERM with a force-kill after a
    short wait: a run on 2026-08-24 spent that wait here being patient, was
    killed part way through, and so never removed a single container. Fifty
    rootfs copies of about three gigabytes each then filled the disk quota at
    trial 50 of 89. There is nothing to be gentle about in a container that is
    being torn down anyway.
    """
    if child.poll() is not None:
        return
    try:
        group = os.getpgid(child.pid)
    except ProcessLookupError:
        return

    for stop in (signal.SIGKILL,) if hard else (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(group, stop)
        except ProcessLookupError:
            return
        deadline = time.monotonic() + (GRACE if stop == signal.SIGTERM else 5)
        while time.monotonic() < deadline:
            if child.poll() is not None:
                return
            time.sleep(0.2)

    print(
        f"singularity-udocker-shim: process group {group} survived SIGKILL",
        file=sys.stderr,
    )


def remove_container(name: str, container_id: str) -> int:
    """Remove a container, repairing the permissions udocker trips over.

    Best effort on purpose: a trial whose cleanup fails should still report its
    own result, and the alternative to a warning here is a silent leak.
    """
    try:
        subprocess.run([UDOCKER, "rm", name], capture_output=True, check=False)
    except OSError as error:
        print(f"singularity-udocker-shim: udocker rm failed: {error}", file=sys.stderr)

    root = Path(os.environ.get("UDOCKER_DIR", Path.home() / ".udocker")) / "containers"
    removed = 0
    for directory in (root / container_id if container_id else None, root / name):
        if directory is None or not directory.is_dir():
            continue
        force_remove(directory)
        if directory.exists():
            print(
                f"singularity-udocker-shim: could not remove {directory}",
                file=sys.stderr,
            )
        else:
            removed = 1
    return removed


def force_remove(directory: Path) -> None:
    """Delete a tree containing directories PRoot left unreadable.

    The permissions have to be repaired top down, and each directory has to be
    made readable *before* its contents are listed. `rglob` cannot do that: it
    lists a directory in order to yield it, so a mode-000 directory is skipped
    before the chmod that would have opened it ever runs.
    """
    # A container's name is a symlink to its id directory. rmtree refuses a
    # symlink, so removing one that way leaves it behind reporting failure.
    if directory.is_symlink():
        directory.unlink(missing_ok=True)
        return

    pending = [directory]
    while pending:
        current = pending.pop()
        try:
            current.chmod(0o700)
        except OSError:
            pass
        try:
            for entry in current.iterdir():
                if entry.is_dir() and not entry.is_symlink():
                    pending.append(entry)
        except OSError:
            pass
    shutil.rmtree(directory, ignore_errors=True)


def main() -> int:
    if len(sys.argv) < 2:
        return fail("no subcommand")

    # Global flags before the subcommand, e.g. `singularity --quiet exec ...`.
    argv = sys.argv[1:]
    while argv and argv[0].startswith("-"):
        if argv[0] in ("--version", "-v"):
            print("singularity-udocker-shim (udocker backend)")
            return 0
        argv = argv[1:]

    if not argv:
        return fail("no subcommand")

    subcommand, rest = argv[0], argv[1:]
    if subcommand == "pull":
        return pull(rest)
    if subcommand in ("exec", "run"):
        return exec_(rest)
    if subcommand == "sweep":
        return sweep()
    if subcommand == "remove":
        if len(rest) != 2:
            return fail("expected 'remove <container_id> <name>'")
        remove_container(rest[1], rest[0])
        return 0
    return fail(f"unsupported subcommand '{subcommand}'")


if __name__ == "__main__":
    sys.exit(main())
